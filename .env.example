# Copy to .env (release builds) and .env.dev (debug/profile builds). Both git-ignored; read by envied at build time
# (`dart run build_runner build`). Not secret: the API address is public. Re-run build_runner after a change.
#
# .env      API_BASE_URL=https://api.bukuresipi.com
# .env.dev  API_BASE_URL=http://10.0.2.2:8787   (Android emulator -> your Mac's `wrangler dev`;
#                                                iOS simulator: http://localhost:8787; a phone: your Mac's LAN IP)
API_BASE_URL=https://api.bukuresipi.com
