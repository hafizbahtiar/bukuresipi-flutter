# Copy to .env (git-ignored). Read by envied at build time: re-run `dart run build_runner build` after a change.
# Not secret: the API address is public.
API_BASE_URL=https://api.bukuresipi.com
# The WEB OAuth client id for Google sign-in (bukuresipi-hono docs/google-signin-setup.md). Empty = no Google button.
GOOGLE_SERVER_CLIENT_ID=
